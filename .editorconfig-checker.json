{
  "Exclude": [
    "(^|/)__pycache__/",
    "(^|/)\\.mypy_cache/",
    "(^|/)\\.pytest_cache/",
    "(^|/)\\.ruff_cache/",
    "(^|/)\\.venv/"
  ],
  "Disable": {
    "Charset": true,
    "Indentation": true,
    "IndentSize": true,
    "TrimTrailingWhitespace": true,
    "InsertFinalNewline": true,
    "MaxLineLength": true
  }
}
