{
  "Exclude": [
    "(^|/)\\.artifacts/",
    "(^|/)\\.mypy_cache/",
    "(^|/)\\.pytest_cache/",
    "(^|/)\\.ruff_cache/",
    "(^|/)\\.venv/",
    "(^|/)__pycache__/",
    "(^|/)bin/",
    "(^|/)obj/"
  ],
  "Disable": {
    "Charset": true,
    "Indentation": true,
    "IndentSize": true,
    "TrimTrailingWhitespace": true,
    "InsertFinalNewline": true,
    "MaxLineLength": true
  }
}
