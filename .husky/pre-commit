#!/bin/sh
# shellcheck disable=SC1091  # Generated by Husky install, not present at lint time.
. "$(dirname "$0")/_/husky.sh"
set -eu

# Local pre-commit: language formatting/lint, plus the fleet's shared doc gates.
# The doc gates run via hub_fetch_run.py, copied into the repo root, where every downstream repo keeps it.
# It fetches them fresh from ptr727/ProjectTemplate's `main` branch rather than vendoring or pinning them.
# See hub_fetch_run.py's own docstring, and catalog/snippets/husky/README.md, for why.
# Full doc-lint set (Markdown, spelling, workflow YAML, EditorConfig) stays in CI and the VS Code Lint tasks, since those need Docker.

# Git already runs a hook from the top level, but this is belt and braces for an invocation that does not.
# The doc gates below take a relative scan root, which would otherwise resolve against whatever directory the caller stood in.
cd "$(git rev-parse --show-toplevel)" || exit 1

hub_fetch_run="$PWD/hub_fetch_run.py"

# An interrupt stops the running tool, removes the list file, and re-raises the signal, per CODESTYLE.md "Interrupts in Shell".
# This is POSIX sh, so the trap removes the file itself, since dash runs no EXIT trap when the re-raised signal ends it.
staged=""
child=""
interrupted() {
    if [ -n "$child" ]; then
        kill "$child" 2>/dev/null || :
        wait "$child" || :
    fi
    if [ -n "$staged" ]; then
        rm -f "$staged"
    fi
    echo "pre-commit: interrupted by SIG$1." >&2
    trap - "$1"
    kill -s "$1" "$$"
}
trap 'if [ -n "$staged" ]; then rm -f "$staged"; fi' EXIT
trap 'interrupted INT; exit 130' INT
trap 'interrupted TERM; exit 143' TERM

# The hub_fetch_run.py step runs in the background and is waited for, since a trap runs only once a foreground command returns.
# It stops the gate it starts when the trap stops it.
# The trap stops it with SIGTERM, because a background child ignores SIGINT.
# A launcher such as uvx, uv run, or dotnet stays in the foreground, so a Ctrl-C reaches the tool it starts.
# In the background that tool would ignore SIGINT, and the trap's SIGTERM would reach it only through a launcher that forwards it.
run_child() {
    "$@" &
    child=$!
    status=0
    wait "$child" || status=$?
    child=""
    return "$status"
}

# .NET: CSharpier + dotnet format style via Husky.Net.
# Drop this block in a non-.NET repo, rather than guarding it.
# A repo that keeps it declares dotnet required, and a missing tool fails the commit loudly, not silently.
dotnet husky run || exit 1

# Python: ruff format + ruff check + mypy over RegressionTests/, its lint-only profile, via uvx at their latest releases.
uvx ruff@latest format --check --extend-exclude ./hub_fetch_run.py --force-exclude RegressionTests || exit 1
uvx ruff@latest check --extend-exclude ./hub_fetch_run.py --force-exclude RegressionTests || exit 1
(cd RegressionTests && uvx mypy@latest) || exit 1

# The interpreter is chosen by running the probes spec/host-tools.json declares, in its order.
# Running one rather than testing for a name is the point.
# That is because Git Bash inherits a Windows PATH that can carry a name which fails when run.
if py -3 --version >/dev/null 2>&1; then
    run_py() { run_child py -3 "$@"; }
elif python3 --version >/dev/null 2>&1; then
    run_py() { run_child python3 "$@"; }
else
    echo "pre-commit: neither 'py -3 --version' nor 'python3 --version' ran, so the doc gates did not run." >&2
    exit 1
fi

# The prose gate reads the paths this commit stages, so an unrelated untracked file cannot refuse it.
# `--diff-commit` has the gate diff against HEAD, or against both parents on a merge commit, so no line either parent brought reads as added.
# It reads their working-tree content, so a partially staged file is judged on all of its edits.
# A path that is no longer a file is dropped, since the gate refuses a submodule or a deleted path.
# An empty list skips the gate, which given no path would scan the whole tree.
# The inner sh checks for that itself, since GNU xargs runs once on empty input and BSD xargs does not.
# The list goes to a file and is read from there, because a pipeline hides a failure of its first command.
# `--skip-generated` passes over a staged file in a generated tree, as a whole-tree scan does.
# The run_py function is out of reach of xargs, so uv chooses the interpreter, which hub_fetch_run.py needs anyway.
# The pull request gate reads every line the branch changes against its base.
# The xargs call runs in the foreground, since a signal sent to xargs alone would not reach the gate it starts.
staged=$(mktemp) || exit 1
git diff --cached --name-only --diff-filter=ACMRT -z >"$staged" || exit 1
# shellcheck disable=SC2016  # Each expansion belongs to the inner sh.
xargs -0 sh -c 'fetch=$1; shift; for p do shift; if [ -f "$p" ]; then set -- "$@" "$p"; fi; done
    [ "$#" -eq 0 ] || exec uv run --no-project python "$fetch" .github/actions/prose-gate/prose_lint.py \
        --skip-generated --diff-commit -- "$@"' sh "$hub_fetch_run" <"$staged" || exit 1
run_py "$hub_fetch_run" .github/actions/repo-gate/repo_gate.py --check eol || exit 1

# Markdown and spelling lint parity with CI, only when Markdown files are staged. The editor
# extensions only warn, so this hook is what actually gates a commit on lint errors. markdownlint and
# cspell are Node tools that do not run reliably across Windows, WSL, and Linux, so run them through
# Docker (the same way the CLIs are run elsewhere). To keep this hook reliable and never a false
# blocker, only use images that are already present locally (never pull) and skip when Docker or the
# image is unavailable; CI enforces these regardless. Warm the images with the VS Code "Lint" tasks.
# MSYS_NO_PATHCONV keeps the bind mount correct under Git Bash on Windows; it is a no-op on Linux/WSL.
docs_lint() {
    image="$1"
    shift
    if docker image inspect "$image" >/dev/null 2>&1; then
        MSYS_NO_PATHCONV=1 docker run --rm -v "$(pwd):/workdir" -w /workdir "$image" "$@" || exit 1
    else
        echo "husky: $image not present, skipping lint (run the VS Code Lint tasks or rely on CI)"
    fi
}

if git diff --cached --name-only --diff-filter=ACMR | grep -q '\.md$'; then
    if command -v docker >/dev/null 2>&1; then
        docs_lint davidanson/markdownlint-cli2:latest "**/*.md"
        docs_lint ghcr.io/streetsidesoftware/cspell:latest --no-progress README.md HISTORY.md
    fi
fi
